<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Notification channel for notices about the Tandoor server (plan B18). -->
    <string name="sync_notification_channel_server">Server</string>
    <string name="sync_notification_channel_server_description">Notices about your Tandoor server, such as a new version.</string>

    <!-- The server's Tandoor version changed. %1$s = new version, %2$s = previous version, e.g. 2.6.15 and 2.6.13. -->
    <string name="sync_notification_version_title">Tandoor was updated</string>
    <string name="sync_notification_version_text">Your server now runs Tandoor %1$s (before: %2$s).</string>
    <string name="sync_notification_version_safe_mode">Tandem has not been tested with this version yet. Reading works as usual; your changes wait on this device until a tested version of Tandem is installed.</string>
    <string name="sync_notification_version_writes_off">This version is newer than Tandem supports. Reading works; changes are not sent until Tandem is updated.</string>

    <!-- Fas 4: someone in the household changed the shopping list (channel "shopping"). -->
    <string name="sync_notification_channel_shopping">Shopping list</string>
    <string name="sync_notification_channel_shopping_description">When someone else in the household adds, checks off or removes items.</string>
    <plurals name="sync_notification_shopping_title">
        <item quantity="one">The shopping list changed</item>
        <item quantity="other">%1$d changes on the shopping list</item>
    </plurals>
    <string name="sync_notification_shopping_added_by">%1$s added %2$s</string>
    <string name="sync_notification_shopping_added">%1$s was added</string>
    <string name="sync_notification_shopping_checked">%1$s was checked</string>
    <string name="sync_notification_shopping_removed">%1$s was removed</string>
    <plurals name="sync_notification_shopping_more">
        <item quantity="one">and %1$d more</item>
        <item quantity="other">and %1$d more</item>
    </plurals>
</resources>
