         hemma som går ut. %1$s = ett livsmedel ("Grädde"), %2$d = hur många fler varor eller recept. -->
    <string name="sync_notification_channel_meal_reminders">Måltidspåminnelser</string>
    <string name="sync_notification_channel_meal_reminders_description">Valfria påminnelser om maten, till exempel varor hemma som snart går ut.</string>
