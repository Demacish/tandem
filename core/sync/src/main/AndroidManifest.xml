<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ConnectivityMonitor: whether a network is available (offline first, plan 3.5). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        The "Server" channel's notice when Tandoor's version changed (plan B18). Only declared
        here: Phase 1 does not ask for it, so the notice is posted only once the user has allowed
        notifications for the app (the in-app banner is shown either way).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Fas 5 (kalender lane, plan §7 #36): "Visa i telefonens kalender" writes the meal plan into a
        local calendar of its own. Asked in context when the user turns it on, never at start.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application>
        <!--
            Fas 4 (push lane): the optional fast push (docs/PUSH.md). The UnifiedPush connector
            binds to this service with the distributor's messages; not exported.
        -->
        <service
            android:name="casa.moller.tandem.core.sync.push.TandemPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
