<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Fas 5 (las lane, plan §5.5): Mer → Lås appen asks for the phone's own screen lock through
        the system's BiometricPrompt (security/DeviceAuthenticator.kt). A normal permission, granted
        at install; the lock itself is off until the user turns it on.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
