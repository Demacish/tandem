<?xml version="1.0" encoding="utf-8"?>
<!-- One ringing timer on the lock-screen alarm: its name, "+1 min" and "Stop". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="32dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/timer_alarm_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:textColor="@color/tandem_timer_alarm_text"
        android:textSize="34sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/timer_alarm_plus_one"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:text="@string/timer_action_plus_one_minute"
            android:textSize="20sp" />

        <Button
            android:id="@+id/timer_alarm_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:text="@string/timer_action_stop"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
