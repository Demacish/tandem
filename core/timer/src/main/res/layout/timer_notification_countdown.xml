<?xml version="1.0" encoding="utf-8"?>
<!-- The countdown notification's content on devices that do not draw the standard chronometer
     (AndroidTimerNotifier.useCustomCountdown): the label, a counting-down Chronometer and when
     the timer is done, like the clock apps' timer notifications. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/timer_notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/timer_notification_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/timer_notification_ends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
    </LinearLayout>
</LinearLayout>
