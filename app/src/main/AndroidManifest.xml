<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Backup: allowBackup=false turns off cloud backup, and data_extraction_rules.xml also
        excludes every domain from cloud backup and device-to-device transfer. The device token
        is bound to an Android Keystore key that never leaves the device, so restored data could
        not be decrypted anyway; after a phone change the user logs in again (plan 5.5).
    -->
    <application
        android:name=".TandemApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tandem">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tandem.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            WorkManager is initialized on demand with TandemApplication's configuration (the Hilt
            worker factory of core:sync), so its default startup initializer is removed. The other
            startup initializers (e.g. the process lifecycle) stay.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Fas S review (fix-ui, plan §8.8): the bundled ML Kit libraries pull in Google's
            datatransport (Clearcut) and would send usage and performance metrics to Google.
            Tandem talks only to the user's Tandoor, Open Food Facts (only the barcode) and the
            AI service the user set up (only the photo), so the upload backend is removed: without
            TransportBackendDiscovery no backend is registered and the queued events are dropped
            on the device. The scheduler service and receiver stay (the runtime names them).
            smoke.yml checks that the minified APK's manifest has neither of them.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!--
            ML Kit starts lazily (feature:scan MlKitStartup, when a scanner is first used) instead
            of in this provider at every process start, a background sync included.
        -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
