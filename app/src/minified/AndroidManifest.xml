<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        ci lane (Fas 1b): Macrobenchmark and the baseline profile generator (:benchmark) read the
        minified build's traces and profiles from the shell. Only this CI build type is
        profileable; release builds are not.
    -->
    <application>
        <profileable android:shell="true" />

        <!--
            Fas 4 (integration): the smoke test runs the morning expiry check through this
            receiver (SmokeWorkerReceiver.kt). This file and src/minified exist only in this CI
            build type; DUMP means only the shell can send it.
        -->
        <receiver
            android:name="casa.moller.tandem.smoke.SmokeWorkerReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
