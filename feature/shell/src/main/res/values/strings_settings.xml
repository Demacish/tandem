    <!-- Permissions overview (design k_kets_beh_righeter_systemguide with its corrections) -->
    <string name="settings_permissions_intro">Tandem asks for permissions when it needs them, for example at your first timer. Here you can see what is allowed and change it in Android’s settings.</string>
    <string name="settings_permissions_privacy_title">Everything stays with you</string>
    <string name="settings_permissions_privacy_body">Tandem only talks to your own Tandoor server. No location, no contacts, no tracking.</string>
    <string name="settings_permission_notifications">Notifications</string>
    <string name="settings_permission_notifications_body">Timers counting down and ringing, and news about your server.</string>
    <string name="settings_permission_alarm_channel">Alarm sound for timers</string>
    <string name="settings_permission_alarm_channel_body">The notification type “Timers (alarm)” must be on, otherwise a finished timer is silent.</string>
    <string name="settings_permission_exact">Alarms on time</string>
    <string name="settings_permission_exact_body">Lets a timer ring on the second, even when the phone is saving power.</string>
    <string name="settings_permission_exact_always">Always allowed in this version of Tandem.</string>
    <string name="settings_permission_full_screen">Alarm on the lock screen</string>
    <string name="settings_permission_full_screen_body">A ringing timer fills the screen, also when the phone is locked.</string>
    <string name="settings_permission_battery">Battery saving</string>
    <string name="settings_permission_battery_body">Some phones stop apps in the background to save power. Set Tandem to “Unrestricted” under Battery so syncs and timers are not stopped.</string>
    <string name="settings_permission_allowed">Allowed</string>
    <string name="settings_permission_not_allowed">Not allowed</string>
    <string name="settings_permission_unrestricted">Unrestricted</string>
    <string name="settings_permission_restricted">Optimised</string>
    <string name="settings_permission_open">Open settings</string>
    <string name="settings_permission_open_description">Open Android’s settings for %1$s</string>

