    <string name="settings_sync_interval_360">Var 6:e timme</string>
    <string name="settings_sync_interval_manual">Bara när jag öppnar appen</string>
    <string name="settings_sync_interval_body">Tandem synkar alltid när du öppnar appen och när du drar nedåt för att uppdatera. Synk i bakgrunden väntar på nätverk och på att batteriet inte är nästan tomt.</string>
