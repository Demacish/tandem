    <!-- Kokläge och timers -->
    <string name="settings_timers">Timers</string>
    <string name="settings_timer_in_app">I Tandem</string>
    <string name="settings_timer_in_app_body">Flera timers samtidigt, ”+1 min” och ett larm som ringer på låsskärmen. Rekommenderas.</string>
    <string name="settings_timer_clock_app">I klockappen</string>
    <string name="settings_timer_clock_app_body">Tandem lämnar varje timer till telefonens klockapp och följer den inte längre.</string>
    <string name="settings_timer_no_clock_app">Ingen klockapp som kan ta emot timers hittades på telefonen.</string>
    <string name="settings_timer_alarm_warning_title">Dina timers kanske inte ringer som de ska</string>
    <string name="settings_timer_alarm_warning_silent">Tandem får inte visa notiser, eller så är larmnotiserna avstängda. En timer ringer då bara medan Tandem är öppen.</string>
    <string name="settings_timer_alarm_warning_late">Tandem får inte ställa exakta larm, så Android kan försena en timer några minuter.</string>
    <string name="settings_open_permissions">Kontrollera behörigheter</string>
