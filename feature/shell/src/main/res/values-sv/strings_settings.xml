    <string name="settings_diagnostics_export">Exportera logg</string>
    <string name="settings_diagnostics_export_body">En text med versioner, inställningar, synkstatus, väntande ändringar, feltyper, mätningarna och den senaste kraschen om det fanns någon. Den innehåller aldrig lösenord, token, din serveradress eller recept. Du väljer själv var den delas.</string>
