    <string name="sync_blocked_title">Servern nekar Tandem just nu</string>
    <string name="sync_blocked_body">Tandoor, eller något framför den, stoppar synken en stund. Recepten på telefonen fungerar som vanligt, och Tandem försöker igen senare.</string>
    <string name="sync_breaker_title">Synken tar en kort paus</string>
    <string name="sync_breaker_body">Det blev många fel på kort tid, så Tandem väntar några minuter innan nästa försök. Recepten på telefonen fungerar som vanligt.</string>
