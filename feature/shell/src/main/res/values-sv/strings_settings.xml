    <string name="settings_image_cache_not_cleared">Bildcachen kunde inte tömmas.</string>
    <string name="settings_demo_no_sync">Demoläget har ingen server, så det finns inget att synka eller ladda ner.</string>

    <!-- Behörigheter -->
    <string name="settings_permissions_intro">Tandem frågar om behörigheter när de behövs, till exempel vid din första timer. Här ser du vad som är tillåtet och kan ändra det i Androids inställningar.</string>
    <string name="settings_permissions_privacy_title">Allt stannar hos dig</string>
    <string name="settings_permissions_privacy_body">Tandem pratar bara med din egen Tandoor-server. Ingen position, inga kontakter, ingen spårning.</string>
    <string name="settings_permission_notifications">Notiser</string>
    <string name="settings_permission_notifications_body">Timers som räknar ned och ringer, och nyheter om din server.</string>
    <string name="settings_permission_alarm_channel">Larmljud för timers</string>
    <string name="settings_permission_alarm_channel_body">Notistypen ”Timers (larm)” måste vara på, annars är en färdig timer tyst.</string>
    <string name="settings_permission_exact">Larm i rätt tid</string>
    <string name="settings_permission_exact_body">Låter en timer ringa på sekunden, även när telefonen sparar ström.</string>
    <string name="settings_permission_exact_always">Alltid tillåtet i den här versionen av Tandem.</string>
    <string name="settings_permission_full_screen">Larm på låsskärmen</string>
    <string name="settings_permission_full_screen_body">En timer som ringer fyller skärmen, även när telefonen är låst.</string>
    <string name="settings_permission_battery">Batterisparläge</string>
    <string name="settings_permission_battery_body">Vissa telefoner stoppar appar i bakgrunden för att spara ström. Ställ in Tandem på ”Obegränsad” under Batteri så att synk och timers inte stoppas.</string>
