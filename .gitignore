# Public debug-only signing key (not a secret, see app/build.gradle.kts).
!app/debug.p12
*.pfx
*.pem
# Public, TEST-ONLY CA of the release smoke test: trusted only by the .minified build type
# (app/src/minified), never by debug or release builds. Not a secret (docs/BYGGE.md).
!app/src/minified/res/raw/tandem_smoke_test_ca.pem
!smoke/src/main/assets/tandem-smoke-test-ca.pem
keystore.properties
signing.properties
signing/
.env
.env.*

