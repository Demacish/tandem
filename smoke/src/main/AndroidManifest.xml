<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The fake Tandoor (MockWebServer) listens on localhost inside this test APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The offline test checks that the emulator really has no network (ConnectivityManager). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Fas 5 (kalender lane): the calendar test reads the emulator's calendar provider, as a
        calendar app would, to see the meals the app wrote (granted with pm grant in the test).
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Package visibility (API 30+): the test launches the app under test by package name. -->
    <queries>
        <package android:name="casa.moller.tandem.minified" />
    </queries>

    <application>
        <!--
            Fas 4 (integration): this test APK is the emulator's only UnifiedPush distributor, so
            the minified app's connector, its service and the message decryption run for real
            (FakeDistributor.kt). The app under test needs no hook for it.
        -->
        <receiver
            android:name=".FakeDistributorReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
