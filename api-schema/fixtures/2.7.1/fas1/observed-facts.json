  "templates.svamppasta": [
    "<p>Skiva <plural-name singular=\"champinjon\" plural=\"champinjoner\" v-bind:amount=\"250.0\" v-bind:factor=\"ingredient_factor\" :no-amount=\"false\"></plural-name> och hacka <scalable-number v-bind:number=\"1.0\" v-bind:factor=\"ingredient_factor\"></scalable-number> st <plural-name singular=\"gul lök\" plural=\"gula lökar\" v-bind:amount=\"1.0\" v-bind:factor=\"ingredient_factor\" :no-amount=\"false\"></plural-name>.<br>\nPressa <scalable-number v-bind:number=\"2.0\" v-bind:factor=\"ingredient_factor\"></scalable-number> <plural-name singular=\"vitlöksklyfta\" plural=\"vitlöksklyftor\" v-bind:amount=\"2.0\" v-bind:factor=\"ingredient_factor\" :no-amount=\"false\"></plural-name>.</p>",
    "<p>Koka pastan i <scalable-number v-bind:number=\"3.0\" v-bind:factor=\"ingredient_factor\"></scalable-number> liter saltat vatten.</p>",
