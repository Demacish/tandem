{
  "name": "login-multipart",
  "request": {
    "method": "POST",
    "path": "/api-token-auth/",
    "headers": {
      "accept": "application/json",
      "content-type": "multipart/form-data; boundary=d3cf02e3-cb0a-44ab-bc98-bf416be96387"
    },
    "body": {
      "username": "<username>",
      "password": "<password>"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "allow": "POST, OPTIONS",
      "content-language": "en",
      "content-type": "application/json",
      "cross-origin-opener-policy": "same-origin",
      "referrer-policy": "same-origin",
      "server": "nginx",
      "vary": "Accept-Language, Cookie",
      "x-content-type-options": "nosniff",
      "x-frame-options": "SAMEORIGIN"
    },
    "isJson": true,
    "body": {
      "id": 1,
      "token": "tda_00000000_0000_0000_0000_000000000001",
      "scope": "read write app",
      "expires": "2000-01-01T00:00:00.000000Z",
      "user_id": 1,
      "test": 1
    }
  }
}
